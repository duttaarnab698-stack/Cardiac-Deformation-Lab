# ==============================================================================
# CARDIAC DEFORMATION LAB — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure appropriate values for your deployment.
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# DISCLAIMER: Research prototype only. Not for clinical diagnostic use.
# ==============================================================================

# Application Environment (development | production | testing)
ENVIRONMENT=development

# JWT Authentication Secret Key (MUST be changed in production: 32+ cryptographically random bytes)
JWT_SECRET_KEY=cardiac-lab-dev-secret-key-32bytes-secure!

# JWT Token Expiration in Minutes (e.g. 60 = 1 hour, 480 = 8 hours)
JWT_EXPIRE_MINUTES=60

# Allowed CORS Origins (comma-separated list of origins permitted to access API)
# Example: http://localhost:5173,http://127.0.0.1:5173,https://my-lab-domain.org
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# File Upload Size Limits
# Maximum single image upload size in bytes (default: 50MB = 52428800)
MAX_IMAGE_UPLOAD_BYTES=52428800

# Maximum video upload size in bytes (default: 200MB = 209715200)
MAX_VIDEO_UPLOAD_BYTES=209715200

# Temporal Sequence Frame Limit (prevents memory exhaustion from long video processing)
MAX_TEMPORAL_FRAMES=300

# Logging Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO
